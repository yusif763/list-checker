# DeepSeek AI (şəxsiyyət vəsiqəsi çıxarışı və çətin uyğunlaşdırma üçün)
# Açar olmadıqda AI funksiyaları deaktiv olur; deterministik yoxlama işləməyə davam edir.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AI ümumiyyətlə aktivdirmi? (true/false). Açar yoxdursa avtomatik deaktiv sayılır.
AI_ENABLED=true
